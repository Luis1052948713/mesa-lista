# Copia este archivo como .env.local y llena los valores.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave de servicio: solo en el servidor. Nunca la pongas en el navegador ni en git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron de recordatorios ---
# Cadena larga y aleatoria. El cron la manda como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp) ---
# Sin estas variables la app funciona igual, pero los recordatorios se envían a mano.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings → Basic → App secret. Sirve para verificar que el webhook viene de Meta.
WHATSAPP_APP_SECRET=
# Texto que tú inventas y pegas también en la configuración del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=recordatorio_reserva
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_API_VERSION=v21.0
